---
import "../styles/global.css";
const { title } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Montserrat:wght@700;800&display=swap"
      rel="stylesheet"
    />
    
    <!-- Inline script to prevent FOUC and detect user system preferences before rendering -->
    <script is:inline>
      (function() {
        try {
          var savedTheme = localStorage.getItem('theme');
          if (savedTheme) {
            document.documentElement.setAttribute('data-theme', savedTheme);
          } else {
            var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            var defaultTheme = prefersDark ? 'dark' : 'light';
            document.documentElement.setAttribute('data-theme', defaultTheme);
            localStorage.setItem('theme', defaultTheme);
          }

          var savedLang = localStorage.getItem('lang');
          if (savedLang) {
            document.documentElement.setAttribute('lang', savedLang);
          } else {
            var userLang = navigator.language || navigator.userLanguage || '';
            var defaultLang = 'en';
            if (userLang.toLowerCase().startsWith('id')) defaultLang = 'id';
            if (userLang.toLowerCase().startsWith('ja')) defaultLang = 'ja';
            document.documentElement.setAttribute('lang', defaultLang);
            localStorage.setItem('lang', defaultLang);
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <div class="floating-controls">
      <button id="term-trigger" class="theme-toggle" aria-label="Open Terminal">
        <span class="toggle-text" data-i18n="nav-term">Terminal</span>
        <span class="mode-icon">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polyline points="4 17 10 11 4 5"></polyline>
            <line x1="12" y1="19" x2="20" y2="19"></line>
          </svg>
        </span>
      </button>

      <div class="lang-dropdown-container" id="lang-dropdown-container">
        <button
          id="lang-toggle"
          class="theme-toggle"
          aria-label="Change Language"
        >
          <span class="toggle-text" id="current-lang-text">EN</span>
          <span class="mode-icon">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="2" y1="12" x2="22" y2="12"></line>
              <path
                d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
              ></path>
            </svg>
          </span>
        </button>
        <div class="lang-dropdown-menu" id="lang-menu">
          <button class="lang-option" data-lang="en">English</button>
          <button class="lang-option" data-lang="id">Bahasa Indonesia</button>
          <button class="lang-option" data-lang="ja">日本語</button>
        </div>
      </div>

      <button id="theme-toggle" class="theme-toggle" aria-label="Toggle Theme">
        <span class="toggle-text" data-i18n="nav-theme">Dark</span>
        <span class="mode-icon" id="theme-icon">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </span>
      </button>
    </div>

    <slot />

    <div class="modal" id="cert-modal">
      <img class="modal-content" id="modal-image" src="" alt="Expanded View" />
    </div>

    <div class="terminal-overlay" id="terminal-overlay">
      <div class="terminal-window">
        <div class="terminal-header">
          <div class="term-title">
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><polyline points="4 17 10 11 4 5"></polyline><line
                x1="12"
                y1="19"
                x2="20"
                y2="19"></line></svg
            >
            <span class="term-title-text"></span>
          </div>
          <div class="term-controls">
            <div class="term-btn" id="term-min">
              <svg
                width="12"
                height="12"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><line x1="4" y1="12" x2="20" y2="12"></line></svg>
            </div>
            <div class="term-btn" id="term-max">
              <svg
                width="12"
                height="12"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><rect x="4" y="4" width="16" height="16" rx="2" ry="2"
                ></rect></svg>
            </div>
            <div class="term-btn close" id="term-close">
              <svg
                width="12"
                height="12"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><line x1="18" y1="6" x2="6" y2="18"></line><line
                  x1="6"
                  y1="6"
                  x2="18"
                  y2="18"></line></svg>
            </div>
          </div>
        </div>
        <div class="terminal-body">
          <div class="term-line" id="term-intro" data-i18n="term-intro">
            Type 'help' to see available commands.
          </div>
          <div id="term-history"></div>
          <div class="term-input-line">
            <span class="term-prompt">C:\Aaron-Nathanael&gt;</span>
            <input
              type="text"
              class="term-input"
              id="term-input"
              autocomplete="off"
              spellcheck="false"
            />
          </div>
        </div>
      </div>
    </div>
  </body>

  <!-- Defer loading for performance mapping -->
  <script
    is:inline
    defer
    src="https://cdnjs.cloudflare.com/ajax/libs/matter-js/0.19.0/matter.min.js"
  ></script>
  <script is:inline defer src={`${base}/assets/js/main.js`}></script>
</html>
